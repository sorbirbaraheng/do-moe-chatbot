# DO-MOE Education Chatbot Backend Configuration
GEMINI_API_KEY=AIzaSyDUhUh16OYfhXZBRuGMvUmFa8TjL5KRlzA
QDRANT_URL=http://203.159.242.144:6333
QDRANT_TIMEOUT=60
VALID_VALUES_QDRANT_TIMEOUT=5
VALID_VALUES_RETRY_SECONDS=300
ENABLE_VALID_VALUES_FETCH=1

# Redis Cloud - Production Session Storage
REDIS_URL=redis://default:FPK9yM65WNMhdEVqb4S4eYhYWOts0Tpc@redis-15806.c296.ap-southeast-2-1.ec2.cloud.redislabs.com:15806
SESSION_TTL_SECONDS=604800

# Groq API (Primary LLM - faster and free)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Admin Auth (Backend)
ADMIN_PASSWORD_HASH='pbkdf2:sha256:1000000$ePPIGGS6OxnZ2MC8$4cfa6ac1eec434077870d13ee4fc4903569c6c70dc21c5959d522cc473cfc39e'
ADMIN_TOKEN_SECRET=gxkVOizpkzz7GBhvpbj0ky4DnonovgRFTu-buTbD76k
ADMIN_TOKEN_TTL_SECONDS=86400

# Performance / Scale
# Enable semantic cache (Redis + Qdrant)
ENABLE_SEMANTIC_CACHE=1
# Cache numeric/stat responses (reduce Qdrant + LLM load)
CACHE_NUMERIC_RESPONSES=1
# Deterministic responses for high-load (set 1 to reduce LLM usage)
ENABLE_DETERMINISTIC_RESPONSES=0
# Max concurrent in-flight requests (0 = unlimited)
MAX_ACTIVE_REQUESTS=60
# Optional: embedding model preference (fallback order)
EMBEDDING_MODELS=models/gemini-embedding-001,models/text-embedding-004,models/embedding-001
# Backoff seconds when providers are rate-limited
GROQ_BACKOFF_SECONDS=30
EMBEDDING_BACKOFF_SECONDS=30
# Redis connection pool size
REDIS_MAX_CONNECTIONS=50
# CORS allowed origins (comma-separated). Example:
# ALLOWED_ORIGINS=https://your-domain.com,https://admin.your-domain.com
ALLOWED_ORIGINS=
# Enable chat metrics logging
ENABLE_CHAT_METRICS=0
# Disable Firestore config load for local QA (set 0 in production)
DISABLE_FIRESTORE=1
# Enable debug routing endpoint for QA (disable in production)
ENABLE_DEBUG_ENDPOINTS=1
