# =====================================================
# DO-MOE Education Chatbot — Backend Deploy Template
# =====================================================
# ⚠️  NEVER commit real secrets to Git!
#     Copy this file and fill in actual values on the server.
# =====================================================

# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Vector Database
QDRANT_URL=http://your-qdrant-host:6333
QDRANT_TIMEOUT=60
VALID_VALUES_QDRANT_TIMEOUT=5
VALID_VALUES_RETRY_SECONDS=300
ENABLE_VALID_VALUES_FETCH=1

# Redis — Production Session Storage
# Get from Redis Cloud console or your own Redis server
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@your-redis-host:port
SESSION_TTL_SECONDS=604800

# Admin Auth (Backend)
# Generate hash: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR_STRONG_PASSWORD'))"
ADMIN_PASSWORD_HASH=your_pbkdf2_hash_here
# ⚠️  Do NOT set ADMIN_PASSWORD in plaintext! Use only the hash above.
ADMIN_TOKEN_SECRET=your_random_secret_here
ADMIN_TOKEN_TTL_SECONDS=86400

# Performance / Scale
ENABLE_SEMANTIC_CACHE=1
CACHE_NUMERIC_RESPONSES=1
ENABLE_DETERMINISTIC_RESPONSES=0
MAX_ACTIVE_REQUESTS=60
EMBEDDING_MODELS=models/gemini-embedding-001,models/text-embedding-004,models/embedding-001
GROQ_BACKOFF_SECONDS=30
EMBEDDING_BACKOFF_SECONDS=30
REDIS_MAX_CONNECTIONS=50

# CORS — Production: only your domain(s)
ALLOWED_ORIGINS=https://ai-bot.moe.go.th

# Monitoring
ENABLE_CHAT_METRICS=0
DISABLE_FIRESTORE=0

# ⚠️  MUST be 0 in production!
ENABLE_DEBUG_ENDPOINTS=0
