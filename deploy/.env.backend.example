# Backend production env
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

QDRANT_URL=http://203.159.242.144:6333
QDRANT_TIMEOUT=60

REDIS_URL=redis://user:pass@host:6379/0
SESSION_TTL_SECONDS=604800

# CORS (comma-separated)
ALLOWED_ORIGINS=https://your-domain,https://www.your-domain

# Admin/Auth (use one of plain or hash)
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
OPERATOR_PASSWORD=
OPERATOR_PASSWORD_HASH=
VIEWER_PASSWORD=
VIEWER_PASSWORD_HASH=
ADMIN_TOKEN_SECRET=change-me
ADMIN_TOKEN_TTL_SECONDS=43200

# Optional
ENABLE_DEBUG_ENDPOINTS=0
DISABLE_FIRESTORE=0

# Gunicorn tuning
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_LOG_LEVEL=info
