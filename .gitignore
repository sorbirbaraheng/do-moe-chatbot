# =====================================================
# DO-MOE Project .gitignore
# =====================================================

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build outputs
dist/
dist-ssr/
build/
*.local

# =====================================================
# 🔐 SENSITIVE FILES - NEVER COMMIT!
# =====================================================
.env
.env.local
.env.*.local
backend/.env
backend/shared_config.json
*.pem
*.key
serviceAccountKey.json

# Database files
*.db
*.sqlite
*.sqlite3
backend/sessions.db

# =====================================================
# Logs
# =====================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/*.log

# Editor & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Cache
.cache/
.parcel-cache/
.npm/
