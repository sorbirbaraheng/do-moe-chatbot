# =====================================================
# DO-MOE Backend Environment Configuration
# =====================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# =====================================================
# LLM APIs (At least one is required)
# =====================================================

# Gemini API Key (Google AI Studio)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Recommended - faster)
# Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# =====================================================
# Vector Database (Required)
# =====================================================

# Qdrant Server URL
QDRANT_URL=http://203.159.242.144:6333
QDRANT_TIMEOUT=60

# =====================================================
# Session Storage (Optional - defaults to SQLite)
# =====================================================

# Redis URL (Production recommended)
# Local: redis://localhost:6379/0
# Cloud: redis://user:password@host:port
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=604800

# =====================================================
# Flask Server
# =====================================================
FLASK_PORT=5001
FLASK_HOST=0.0.0.0

# =====================================================
# Logging
# =====================================================
LOG_LEVEL=INFO
