rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: check if user is self (by uid OR email — chatService uses email as userId)
    function isSelf(userId) {
      return request.auth != null
        && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // Helper: check if user has admin/operator role
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'operator'];
    }

    // Settings collection: 
    // - Authenticated users can READ (to get prompts/models).
    // - Only admin/operator can WRITE.
    match /settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Users collection & all subcollections (sessions, messages):
    // - Self: Read/Write own data (matched by uid OR email).
    // - Admin: Read/Write EVERYONE's data.
    // - Any authenticated user can read user list.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isSelf(userId) || isAdmin();

      // Sessions subcollection: users/{userId}/sessions/{sessionId}
      match /sessions/{sessionId} {
        allow read, write: if isSelf(userId) || isAdmin();

        // Messages sub-subcollection: users/{userId}/sessions/{sessionId}/messages/{msgId}
        match /messages/{msgId} {
          allow read, write: if isSelf(userId) || isAdmin();
        }
      }

      // Any other subcollection under the user doc
      match /{subcollection=**} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if isSelf(userId) || isAdmin();
      }
    }

    // Legacy Chat Logs collection:
    // - Authenticated users can create logs.
    // - Can read own logs or legacy logs without owner.
    match /chat_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (!('userId' in resource.data) || resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email);
      allow update, delete: if false; 
    }

    // Legacy Chat Sessions collection:
    match /chat_sessions/{sessionId} {
      allow read: if request.auth != null && (!('userId' in resource.data) || resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email);
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (!('userId' in resource.data) || resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email);
    }

    // Default: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
